# JWT secret key for signing authentication tokens (minimum 32 characters)
JWT_SECRET_KEY=jobtrack_super_secret_jwt_key_2026_dev_secure_token_min32chars

# Default uses SQLite for the easiest first run.
DATABASE_URL=sqlite:///./jobtrack.db

# For PostgreSQL with Docker, use:
# DATABASE_URL=postgresql+psycopg://jobtrack:jobtrack_dev_password@localhost:5432/jobtrack
